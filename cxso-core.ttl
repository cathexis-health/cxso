@prefix cxso: <https://w3id.org/cxso/> .
@prefix cso11: <https://cathexis.health/ontology/cso/v1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

cxso:core rdf:type owl:Ontology ;
    dcterms:creator "Justin DeGarbo" ;
    dcterms:description "The CSO core: an observation vocabulary for first-person somatic experience that can be used without any clinical theory. Zones, sensation qualities, intensity, time, evidence kind, and the data point, snapshot and trajectory structure."@en ;
    dcterms:identifier "10.5281/zenodo.18859896" ;
    dcterms:issued "2026-05-29"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-26"^^xsd:date ;
    dcterms:publisher "Cathexis Health LLC" ;
    dcterms:title "Cathexis Somatic Ontology (CSO): core"@en ;
    vann:preferredNamespacePrefix "cxso" ;
    vann:preferredNamespaceUri "https://w3id.org/cxso/" ;
    owl:versionIRI <https://w3id.org/cxso/releases/2.0.0/cxso-core.ttl> ;
    owl:versionInfo "2.0.0" .

# Terms live under permanent codes (CXSO_0000001 onward).
# Each v1.1 identifier is kept, deprecated, directly after the code that replaces it.

# SomaticEntity -> CXSO_0000001  [core]
cxso:CXSO_0000001 rdf:type owl:Class ;
    rdfs:label "Somatic Entity"@en ;
    skos:prefLabel "Somatic Entity"@en ;
    skos:definition "The root class for every entity in the Cathexis Somatic Ontology."@en .

cso11:SomaticEntity rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticEntity"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000001 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# SomaticDataPoint -> CXSO_0000002  [core]
cxso:CXSO_0000002 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Somatic Data Point"@en ;
    skos:prefLabel "Somatic Data Point"@en ;
    skos:definition "A single sensation report: where in the body (zone), what kind (quality), and optionally how intense (a whole number from 0 to 10). The atomic unit of somatic data."@en .

cso11:SomaticDataPoint rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticDataPoint"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000002 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# SomaticSnapshot -> CXSO_0000003  [core]
cxso:CXSO_0000003 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Somatic Snapshot"@en ;
    skos:prefLabel "Somatic Snapshot"@en ;
    skos:definition "A complete body state at a single moment. It holds zero or more data points; with none, nothing stands out may record that the person attended to their sensations and found nothing standing out."@en .

cso11:SomaticSnapshot rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticSnapshot"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000003 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# SomaticTrajectory -> CXSO_0000004  [core]
cxso:CXSO_0000004 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Somatic Trajectory"@en ;
    skos:prefLabel "Somatic Trajectory"@en ;
    skos:definition "A body state over time: an ordered series of snapshots for one person. Aggregates computed from the series are an implementation concern, not part of the ontology."@en .

cso11:SomaticTrajectory rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticTrajectory"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000004 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# BodyZone -> CXSO_0000010  [core]
cxso:CXSO_0000010 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Body Zone"@en ;
    skos:prefLabel "Body Zone"@en ;
    skos:definition "An area of the body where a person reports a sensation. A zone is the area a person reports, not a precise anatomical boundary; it is linked to UBERON where a corresponding structure exists."@en .

cso11:BodyZone rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete BodyZone"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000010 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# headScalp -> CXSO_0000011  [core]
cxso:CXSO_0000011 rdf:type owl:NamedIndividual, cxso:CXSO_0000010 ;
    rdfs:label "Head / Scalp"@en ;
    skos:prefLabel "Head / Scalp"@en ;
    skos:notation "Zone 1" ;
    skos:definition "Tension headaches, pressure, cognitive overwhelm."@en ;
    skos:closeMatch obo:UBERON_0000033, obo:UBERON_0000403 ;
    cxso:CXSO_0000166 1 .

cso11:headScalp rdf:type owl:NamedIndividual ;
