@prefix cxso: <https://w3id.org/cxso/> .
@prefix cso11: <https://cathexis.health/ontology/cso/v1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<https://w3id.org/cxso> rdf:type owl:Ontology ;
    dcterms:creator "Justin DeGarbo" ;
    dcterms:description "The Cathexis Somatic Ontology (CSO) is an open, machine-readable vocabulary for first-person somatic experience. Release 2.0.0 splits the vocabulary into a core anyone can use without the theory (zones, sensation qualities, intensity, time, evidence kind, and the snapshot and data-point structure) and a clinical extension that imports the core (territories, blanket configurations, affect systems, change and risk mechanisms, practice types, learning levels, territory status, and HES layers). Every term has a permanent opaque code (CXSO_0000001 onward) in the https://w3id.org/cxso/ namespace. Identifiers from CSO v1.1 are kept as deprecated aliases."@en ;
    dcterms:identifier "10.5281/zenodo.18859896" ;
    dcterms:issued "2026-05-29"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-26"^^xsd:date ;
    dcterms:publisher "Cathexis Health LLC" ;
    dcterms:title "Cathexis Somatic Ontology (CSO)"@en ;
    vann:preferredNamespacePrefix "cxso" ;
    vann:preferredNamespaceUri "https://w3id.org/cxso/" ;
    owl:priorVersion <https://cathexis.health/ontology/cso/v1.1.1/> ;
    owl:versionIRI <https://w3id.org/cxso/releases/2.0.0/cxso.ttl> ;
    owl:versionInfo "2.0.0" ;
    skos:changeNote "Release 2.0.0 (November 2026): permanent opaque identifiers (CXSO_0000001 onward) under https://w3id.org/cxso/ replace name-based identifiers, and every v1.1 identifier is kept as a deprecated alias that points to its new code. The ontology is split into a core module and a clinical extension in the same namespace. Intensity becomes an optional whole-number rating from 0 to 10 (a breaking change from the 0.0 to 1.0 scale). New terms include evidence kind, nothing stands out, timestamp, practice types, HES layers, risk mechanisms and territory status. Every term has a definition. Zones are linked to UBERON. Brain regions are labelled by anatomy, not by function. Somatic Experiencing is relabelled Titrated Somatic Contact. SNOMED CT codes are not part of the open release. Paper version 2.3 and ontology release 2.0.0 are numbered separately."@en .

# Terms live under permanent codes (CXSO_0000001 onward).
# Each v1.1 identifier is kept, deprecated, directly after the code that replaces it.

# SomaticEntity -> CXSO_0000001  [core]
cxso:CXSO_0000001 rdf:type owl:Class ;
    rdfs:label "Somatic Entity"@en ;
    skos:prefLabel "Somatic Entity"@en ;
    skos:definition "The root class for every entity in the Cathexis Somatic Ontology."@en .

cso11:SomaticEntity rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticEntity"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000001 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# SomaticDataPoint -> CXSO_0000002  [core]
cxso:CXSO_0000002 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Somatic Data Point"@en ;
    skos:prefLabel "Somatic Data Point"@en ;
    skos:definition "A single sensation report: where in the body (zone), what kind (quality), and optionally how intense (a whole number from 0 to 10). The atomic unit of somatic data."@en ;
    cxso:CXSO_0000154 cxso:CXSO_0000006 .

cso11:SomaticDataPoint rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticDataPoint"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000002 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# SomaticSnapshot -> CXSO_0000003  [core]
cxso:CXSO_0000003 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Somatic Snapshot"@en ;
    skos:prefLabel "Somatic Snapshot"@en ;
    skos:definition "A complete body state at a single moment. It holds zero or more data points; with none, nothing stands out may record that the person attended to their sensations and found nothing standing out."@en ;
    cxso:CXSO_0000154 cxso:CXSO_0000006 .

cso11:SomaticSnapshot rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticSnapshot"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000003 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# SomaticTrajectory -> CXSO_0000004  [core]
cxso:CXSO_0000004 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Somatic Trajectory"@en ;
    skos:prefLabel "Somatic Trajectory"@en ;
    skos:definition "A body state over time: an ordered series of snapshots for one person. Aggregates computed from the series are an implementation concern, not part of the ontology."@en ;
    cxso:CXSO_0000154 cxso:CXSO_0000006 .

cso11:SomaticTrajectory rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete SomaticTrajectory"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000004 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# BlanketComponent -> CXSO_0000005  [clinical]
cxso:CXSO_0000005 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Blanket Component"@en ;
    skos:prefLabel "Blanket Component"@en ;
    skos:definition "One of the four components of Friston's Markov blanket formalism (internal, external, sensory and active states). The clinical extension uses them to organize the classes that describe a person."@en .

cso11:BlanketComponent rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete BlanketComponent"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000005 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# InternalState -> CXSO_0000006  [clinical]
cxso:CXSO_0000006 rdf:type owl:NamedIndividual, cxso:CXSO_0000005 ;
    rdfs:label "Internal State"@en ;
    skos:prefLabel "Internal State"@en ;
    skos:definition "The person's physiological and psychological condition as experienced through interoception. What the person builds observer capacity for."@en .

cso11:InternalState rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    rdfs:label "obsolete InternalState"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000006 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# ExternalState -> CXSO_0000007  [clinical]
cxso:CXSO_0000007 rdf:type owl:NamedIndividual, cxso:CXSO_0000005 ;
    rdfs:label "External State"@en ;
    skos:prefLabel "External State"@en ;
    skos:definition "Environmental conditions influencing internal experience. What the person cannot directly control but must relate to."@en .

cso11:ExternalState rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    rdfs:label "obsolete ExternalState"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000007 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# SensoryState -> CXSO_0000008  [clinical]
cxso:CXSO_0000008 rdf:type owl:NamedIndividual, cxso:CXSO_0000005 ;
    rdfs:label "Sensory State"@en ;
    skos:prefLabel "Sensory State"@en ;
    skos:definition "The boundary where external becomes internal: the translation mechanism. Where prediction lives. The most clinically important component."@en .

cso11:SensoryState rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    rdfs:label "obsolete SensoryState"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000008 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# ActiveState -> CXSO_0000009  [clinical]
cxso:CXSO_0000009 rdf:type owl:NamedIndividual, cxso:CXSO_0000005 ;
    rdfs:label "Active State"@en ;
    skos:prefLabel "Active State"@en ;
    skos:definition "The person's repertoire of responses: actions to minimize prediction error. The intervention library as a toolkit of active states."@en .

cso11:ActiveState rdf:type owl:NamedIndividual ;
    owl:deprecated true ;
    rdfs:label "obsolete ActiveState"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000009 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

# BodyZone -> CXSO_0000010  [core]
cxso:CXSO_0000010 rdf:type owl:Class ;
    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Body Zone"@en ;
    skos:prefLabel "Body Zone"@en ;
    skos:definition "An area of the body where a person reports a sensation. A zone is the area a person reports, not a precise anatomical boundary; it is linked to UBERON where a corresponding structure exists."@en ;
    cxso:CXSO_0000154 cxso:CXSO_0000006 .

cso11:BodyZone rdf:type owl:Class ;
    owl:deprecated true ;
    rdfs:label "obsolete BodyZone"@en ;
    dcterms:isReplacedBy cxso:CXSO_0000010 ;
    skos:historyNote "Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0."@en .

