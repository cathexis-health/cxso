cxso:CXSO_0000194 rdf:type owl:NamedIndividual, cxso:CXSO_0000181 ;
    rdfs:label "Grounding"@en ;
    skos:prefLabel "Grounding"@en ;
    skos:definition "Attention anchored in present external sensory input."@en .

