# temporalLayer -> CXSO_0000209  [clinical]
cxso:CXSO_0000209 rdf:type owl:NamedIndividual, cxso:CXSO_0000182 ;
    rdfs:label "The Temporal Dimension"@en ;
    skos:prefLabel "The Temporal Dimension"@en ;
    skos:notation "temporal" ;
    skos:definition "The temporal dimension of the Human Experience System, the tenth of its layers."@en .

# riskMotivation -> CXSO_0000210  [clinical]
cxso:CXSO_0000210 rdf:type owl:NamedIndividual, cxso:CXSO_0000183 ;
    rdfs:label "Motivation"@en ;
    skos:prefLabel "Motivation"@en ;
    skos:definition "A reason for ending that is specific to the territory, for example \"there's no point\" in Living in Shutdown or \"I'm the problem\" in Living in Shame."@en .

# fearAttenuation -> CXSO_0000211  [clinical]
cxso:CXSO_0000211 rdf:type owl:NamedIndividual, cxso:CXSO_0000183 ;
    rdfs:label "FEAR attenuation"@en ;
    skos:prefLabel "FEAR attenuation"@en ;
    skos:definition "The biological barrier lowering, so the person is less prevented rather than more motivated; for example metabolic conservation in Living in Shutdown, alcohol in Living in Addiction and Compulsion, dissociation in Living Under Siege."@en .

# disinhibitionAndAccessToMeans -> CXSO_0000212  [clinical]
cxso:CXSO_0000212 rdf:type owl:NamedIndividual, cxso:CXSO_0000183 ;
    rdfs:label "Disinhibition and access to means"@en ;
    skos:prefLabel "Disinhibition and access to means"@en ;
    skos:definition "For example intoxication in Living in Addiction and Compulsion, impulsivity in Living in Overwhelm, or means available in the environment."@en .

# riskIsolation -> CXSO_0000213  [clinical]
cxso:CXSO_0000213 rdf:type owl:NamedIndividual, cxso:CXSO_0000183 ;
    rdfs:label "Isolation"@en ;
    skos:prefLabel "Isolation"@en ;
    skos:definition "The absence of a co-regulating other; for example withdrawal in Living in Disconnection, or the intact mask in Living Behind a Mask that makes a person appear fine."@en .

# active -> CXSO_0000214  [clinical]
cxso:CXSO_0000214 rdf:type owl:NamedIndividual, cxso:CXSO_0000184 ;
    rdfs:label "Active"@en ;
    skos:prefLabel "Active"@en ;
    skos:notation "active" ;
    skos:definition "Currently organizing the person's experience."@en .

# dormant -> CXSO_0000215  [clinical]
cxso:CXSO_0000215 rdf:type owl:NamedIndividual, cxso:CXSO_0000184 ;
    rdfs:label "Dormant"@en ;
    skos:prefLabel "Dormant"@en ;
    skos:notation "dormant" ;
    skos:definition "Installed predictions not currently active, which a later trigger may activate."@en .

# hasDataPoint -> CXSO_0000216  [core]
cxso:CXSO_0000216 rdf:type owl:ObjectProperty ;
    rdfs:label "has data point"@en ;
    skos:prefLabel "has data point"@en ;
    skos:definition "A data point that is part of a snapshot. A snapshot with nothing stands out set to true has none."@en ;
    rdfs:domain cxso:CXSO_0000003 ;
    rdfs:range cxso:CXSO_0000002 .

# hasSnapshot -> CXSO_0000217  [core]
cxso:CXSO_0000217 rdf:type owl:ObjectProperty ;
    rdfs:label "has snapshot"@en ;
    skos:prefLabel "has snapshot"@en ;
    skos:definition "A snapshot that is part of a trajectory. A trajectory's snapshots are ordered by their timestamps."@en ;
    rdfs:domain cxso:CXSO_0000004 ;
    rdfs:range cxso:CXSO_0000003 .
