    skos:definition "Breath-based regulation; exhale-dominant patterns support parasympathetic activity."@en .

# bodyScan -> CXSO_0000193  [clinical]
cxso:CXSO_0000193 rdf:type owl:NamedIndividual, cxso:CXSO_0000181 ;
    rdfs:label "Body Scan"@en ;
    skos:prefLabel "Body Scan"@en ;
    skos:definition "Attention moved through the body, building interoceptive awareness and observer capacity."@en .

