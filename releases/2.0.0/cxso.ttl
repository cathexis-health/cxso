    skos:definition "Cycles of tension and release that build awareness of the difference between them."@en .

# containment -> CXSO_0000197  [clinical]
cxso:CXSO_0000197 rdf:type owl:NamedIndividual, cxso:CXSO_0000181 ;
    rdfs:label "Containment"@en ;
    skos:prefLabel "Containment"@en ;
    skos:definition "Practices that build a felt sense of boundary and limit how much is held at once."@en .

# psychoeducation -> CXSO_0000198  [clinical]
cxso:CXSO_0000198 rdf:type owl:NamedIndividual, cxso:CXSO_0000181 ;
    rdfs:label "Psychoeducation"@en ;
    skos:prefLabel "Psychoeducation"@en ;
    skos:definition "Learning how predictions shape experience and how sensations are constructed; supports model updating."@en .

# activation -> CXSO_0000199  [clinical]
cxso:CXSO_0000199 rdf:type owl:NamedIndividual, cxso:CXSO_0000181 ;
    rdfs:label "Activation"@en ;
    skos:prefLabel "Activation"@en ;
    skos:definition "Small movements and contact that raise arousal a little, for states of shutdown, heaviness or flatness (for example Living in Shutdown and Living in Shame), where regulation needs to move upward rather than toward calm."@en .

