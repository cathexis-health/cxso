    rdfs:subClassOf cxso:CXSO_0000001 ;
    rdfs:label "Territory Status"@en ;
    skos:prefLabel "Territory Status"@en ;
    skos:definition "Whether a territory is currently organizing the person's experience (active) or holds installed predictions that are not currently active (dormant)."@en .

# Prediction -> CXSO_0000185  [clinical]
