# w3id.org/cxso: Cathexis Somatic Ontology (CSO)
# Maintainer: Justin DeGarbo, Cathexis Health LLC (GitHub: justindegarbo)
# Files are served from GitHub Pages: https://cathexis-health.github.io/cxso/

Options +FollowSymLinks
RewriteEngine on

# A specific release: https://w3id.org/cxso/releases/2.0.0/cxso.ttl
RewriteRule ^releases/(.+)$ https://cathexis-health.github.io/cxso/releases/$1 [R=302,L]

# The ontology itself: machines get the file they ask for, browsers get the specification
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^$ https://cathexis-health.github.io/cxso/cxso.ttl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^$ https://cathexis-health.github.io/cxso/cxso.owl [R=303,L]
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^$ https://cathexis-health.github.io/cxso/cxso-context.jsonld [R=303,L]
RewriteRule ^$ https://cathexis-health.github.io/cxso/ [R=303,L]

# The modules
RewriteRule ^(core|clinical)$ https://cathexis-health.github.io/cxso/cxso-$1.ttl [R=303,L]

# A term: https://w3id.org/cxso/CXSO_0000020
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^CXSO_[0-9]{7}$ https://cathexis-health.github.io/cxso/cxso.ttl [R=303,L]
RewriteRule ^(CXSO_[0-9]{7})$ https://cathexis-health.github.io/cxso/#$1 [R=303,NE,L]

# The FHIR package
RewriteRule ^fhir/(.*)$ https://cathexis-health.github.io/cxso/fhir/$1 [R=302,L]
