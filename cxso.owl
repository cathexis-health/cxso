  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000203">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000182"/>
    <rdfs:label xml:lang="en">The Neural Layer</rdfs:label>
    <skos:prefLabel xml:lang="en">The Neural Layer</skos:prefLabel>
    <skos:notation>neural</skos:notation>
    <skos:definition xml:lang="en">The neural layer of the Human Experience System.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000195">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000181"/>
    <rdfs:label xml:lang="en">Bilateral Stimulation</rdfs:label>
    <skos:prefLabel xml:lang="en">Bilateral Stimulation</skos:prefLabel>
    <skos:definition xml:lang="en">Alternating left-right stimulation, such as tapping.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/isRichClubHub">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete isRichClubHub</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000164"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000184">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Territory Status</rdfs:label>
    <skos:prefLabel xml:lang="en">Territory Status</skos:prefLabel>
    <skos:definition xml:lang="en">Whether a territory is currently organizing the person's experience (active) or holds installed predictions that are not currently active (dormant).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000059">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Floating</rdfs:label>
    <skos:prefLabel xml:lang="en">Floating</skos:prefLabel>
    <skos:definition xml:lang="en">Untethered, drifting sensation. Living in an Unfamiliar Life: groundlessness. Living Under Siege: dissociative lightness. Distinct from Lightness, which has buoyancy: floating has no anchor.</skos:definition>
    <skos:altLabel xml:lang="en">drifting</skos:altLabel>
    <skos:altLabel xml:lang="en">spacey</skos:altLabel>
    <skos:altLabel xml:lang="en">unanchored</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/BronfenbrennerLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete BronfenbrennerLayer</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000124"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000138">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000134"/>
    <rdfs:label xml:lang="en">Prediction Testing</rdfs:label>
    <skos:prefLabel xml:lang="en">Prediction Testing</skos:prefLabel>
    <skos:notation>L4</skos:notation>
    <skos:definition xml:lang="en">The person tests predictions through action in daily life.</skos:definition>
    <skos:altLabel xml:lang="en">L4: Prediction Testing</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000062">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in Threat</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in Threat</skos:prefLabel>
    <skos:notation>T1</skos:notation>
    <skos:definition xml:lang="en">High-precision threat predictions; ambiguous stimuli interpreted as dangerous.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000079"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>FEAR up, SEEKING down, PLAY down</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000129">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000124"/>
    <rdfs:label xml:lang="en">Chronosystem</rdfs:label>
    <skos:prefLabel xml:lang="en">Chronosystem</skos:prefLabel>
    <skos:definition xml:lang="en">Transitions and shifts over time: life transitions, historical events, developmental changes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000158">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">zone</rdfs:label>
    <skos:prefLabel xml:lang="en">zone</skos:prefLabel>
    <skos:definition xml:lang="en">The anatomical zone where a sensation was reported.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000002"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000012">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Forehead</rdfs:label>
    <skos:prefLabel xml:lang="en">Forehead</skos:prefLabel>
    <skos:notation>Zone 2</skos:notation>
    <skos:definition xml:lang="en">Tension, pressure, furrowing; cognitive strain and worry patterns.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008200"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/MechanismType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete MechanismType</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000146"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000188">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has practice type</rdfs:label>
    <skos:prefLabel xml:lang="en">has practice type</skos:prefLabel>
    <skos:definition xml:lang="en">The practice type of an intervention: what the person does.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000181"/>
  </rdf:Description>
