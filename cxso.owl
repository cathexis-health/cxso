  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000173">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">nothing stands out</rdfs:label>
    <skos:prefLabel xml:lang="en">nothing stands out</skos:prefLabel>
    <skos:definition xml:lang="en">The person attended to their sensations and found nothing standing out. This is a report, distinct from the Numbness quality (a felt absence of sensation) and from a snapshot never taken.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000003"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000216">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has data point</rdfs:label>
    <skos:prefLabel xml:lang="en">has data point</skos:prefLabel>
    <skos:definition xml:lang="en">A data point that is part of a snapshot. A snapshot with nothing stands out set to true has none.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000003"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000002"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000055">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Vibration</rdfs:label>
    <skos:prefLabel xml:lang="en">Vibration</skos:prefLabel>
    <skos:definition xml:lang="en">An inner oscillation felt through a zone, without visible movement. High activation, trauma-related activation, release of accumulated tension.</skos:definition>
    <skos:altLabel xml:lang="en">thrumming</skos:altLabel>
    <skos:altLabel xml:lang="en">vibrating</skos:altLabel>
  </rdf:Description>
