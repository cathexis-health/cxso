    <skos:prefLabel xml:lang="en">Upper Legs / Thighs</skos:prefLabel>
    <skos:notation>Zone 20</skos:notation>
    <skos:definition xml:lang="en">Heaviness, tension, restlessness; flight readiness or collapse.</skos:definition>
    <skos:altLabel xml:lang="en">Upper Legs</skos:altLabel>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000004">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
