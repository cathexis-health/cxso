    <skos:prefLabel xml:lang="en">Microsystem</skos:prefLabel>
    <skos:definition xml:lang="en">Immediate relationships and settings: partner, family, close friends, workplace team, home.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000091">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000084"/>
    <rdfs:label xml:lang="en">LUST</rdfs:label>
    <skos:prefLabel xml:lang="en">LUST</skos:prefLabel>
    <skos:definition xml:lang="en">Sexual motivation. Relevant to Living in Disconnection, Living Under Siege, and relational territories.</skos:definition>
    <cxso:CXSO_0000169>Hypothalamus, ventral tegmental area, amygdala</cxso:CXSO_0000169>
  </rdf:Description>
