  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000109">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Motor / Premotor Cortex</rdfs:label>
    <skos:prefLabel xml:lang="en">Motor / Premotor Cortex</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the primary motor and premotor cortex, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001384"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016634"/>
    <skos:historyNote xml:lang="en">Labelled 'Movement &amp; Regulation' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Motor / Premotor Cortex</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000042">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Heat / Warmth</rdfs:label>
    <skos:prefLabel xml:lang="en">Heat / Warmth</skos:prefLabel>
    <skos:definition xml:lang="en">Radiating temperature increase, flushing. RAGE activation, shame response (facial heat), inflammatory processes.</skos:definition>
    <skos:altLabel xml:lang="en">Heat</skos:altLabel>
    <skos:altLabel xml:lang="en">burning</skos:altLabel>
    <skos:altLabel xml:lang="en">facial heat</skos:altLabel>
    <skos:altLabel xml:lang="en">flushing</skos:altLabel>
    <skos:altLabel xml:lang="en">hot</skos:altLabel>
    <skos:altLabel xml:lang="en">warm</skos:altLabel>
  </rdf:Description>
