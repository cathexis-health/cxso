    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000054">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Aching</rdfs:label>
    <skos:prefLabel xml:lang="en">Aching</skos:prefLabel>
    <skos:definition xml:lang="en">Deep, diffuse, persistent discomfort. Chronic tension patterns, grief somatization, sustained stress.</skos:definition>
    <skos:altLabel xml:lang="en">Ache</skos:altLabel>
    <skos:altLabel xml:lang="en">dull ache</skos:altLabel>
    <skos:altLabel xml:lang="en">sore</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000177">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000172"/>
    <rdfs:label xml:lang="en">Measured by an instrument</rdfs:label>
    <skos:prefLabel xml:lang="en">Measured by an instrument</skos:prefLabel>
    <skos:definition xml:lang="en">Obtained as a measurement by an instrument.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000198">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000181"/>
    <rdfs:label xml:lang="en">Psychoeducation</rdfs:label>
    <skos:prefLabel xml:lang="en">Psychoeducation</skos:prefLabel>
    <skos:definition xml:lang="en">Learning how predictions shape experience and how sensations are constructed; supports model updating.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000081">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000078"/>
    <rdfs:label xml:lang="en">Boundary pattern</rdfs:label>
    <skos:prefLabel xml:lang="en">Boundary pattern</skos:prefLabel>
    <skos:definition xml:lang="en">A blanket organization in which the boundary is distorted: it is misshapen.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'Boundary Disorders (Blanket Misshapen)' before release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000171>Boundary distorted; reshape with self-referential attention.</cxso:CXSO_0000171>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000092">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Brain Region</rdfs:label>
    <skos:prefLabel xml:lang="en">Brain Region</skos:prefLabel>
    <skos:definition xml:lang="en">An anatomical structure of the brain named by the neural layer of the HES. Each region is linked to its term in UBERON, the standard anatomy ontology, with skos:exactMatch, or skos:closeMatch where the match is not exact. The CSO does not define brain anatomy. UBERON does.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000083">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000078"/>
    <rdfs:label xml:lang="en">Existential / Neurological pattern</rdfs:label>
    <skos:prefLabel xml:lang="en">Existential / Neurological pattern</skos:prefLabel>
    <skos:definition xml:lang="en">A blanket organization in which predictions may be accurate, or cannot be tested.</skos:definition>
    <skos:altLabel xml:lang="en">Existential / Neurological</skos:altLabel>
    <cxso:CXSO_0000171>Attend to what is present; predictions may be accurate or untestable.</cxso:CXSO_0000171>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000202">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000182"/>
    <rdfs:label xml:lang="en">The Affective Layer</rdfs:label>
    <skos:prefLabel xml:lang="en">The Affective Layer</skos:prefLabel>
    <skos:notation>affective</skos:notation>
    <skos:definition xml:lang="en">The affective layer of the Human Experience System.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000130">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Change Mechanism</rdfs:label>
    <skos:prefLabel xml:lang="en">Change Mechanism</skos:prefLabel>
    <skos:definition xml:lang="en">A therapeutic change mechanism, each engaging a distinct memory system.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000009"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000086">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000084"/>
    <rdfs:label xml:lang="en">FEAR</rdfs:label>
    <skos:prefLabel xml:lang="en">FEAR</skos:prefLabel>
    <skos:definition xml:lang="en">Threat detection and defensive behavior. The primary driver of Living in Threat. Locked activation of this system is central to Living Under Siege.</skos:definition>
    <cxso:CXSO_0000169>Central amygdala, periaqueductal gray, medial hypothalamus</cxso:CXSO_0000169>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/servesTerritory">
