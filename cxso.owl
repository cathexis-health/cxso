  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000119">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">Social Brain Network</rdfs:label>
    <skos:prefLabel xml:lang="en">Social Brain Network</skos:prefLabel>
    <skos:definition xml:lang="en">Social cognition: reading faces, voices, intentions, and relational context. Models other minds and tracks social dynamics.</skos:definition>
  </rdf:Description>
