  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000005">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Blanket Component</rdfs:label>
    <skos:prefLabel xml:lang="en">Blanket Component</skos:prefLabel>
    <skos:definition xml:lang="en">One of the four components of Friston's Markov blanket formalism (internal, external, sensory and active states). The clinical extension uses them to organize the classes that describe a person.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000125">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
