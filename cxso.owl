    <skos:historyNote xml:lang="en">Labelled 'Sensory Gateway' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Thalamus</cxso:CXSO_0000165>
  </rdf:Description>
