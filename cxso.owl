    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/SomaticSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete SomaticSnapshot</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000003"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000041">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Tightness</rdfs:label>
    <skos:prefLabel xml:lang="en">Tightness</skos:prefLabel>
    <skos:definition xml:lang="en">Constriction, gripping, clenching. FEAR activation, muscular bracing, suppressed expression. Most commonly reported quality across populations.</skos:definition>
    <skos:altLabel xml:lang="en">clenching</skos:altLabel>
    <skos:altLabel xml:lang="en">constriction</skos:altLabel>
    <skos:altLabel xml:lang="en">gripping</skos:altLabel>
    <skos:altLabel xml:lang="en">knot</skos:altLabel>
    <skos:altLabel xml:lang="en">stiffness</skos:altLabel>
    <skos:altLabel xml:lang="en">tense</skos:altLabel>
    <skos:altLabel xml:lang="en">tension</skos:altLabel>
    <skos:altLabel xml:lang="en">tight</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000058">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Contraction</rdfs:label>
    <skos:prefLabel xml:lang="en">Contraction</skos:prefLabel>
    <skos:definition xml:lang="en">Inward-pulling compression. Withdrawal, bracing, protective narrowing. Living in Disconnection, Living in Shame: pulling inward.</skos:definition>
    <skos:altLabel xml:lang="en">collapsing inward</skos:altLabel>
    <skos:altLabel xml:lang="en">pulling in</skos:altLabel>
    <skos:altLabel xml:lang="en">shrinking</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000120">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">Memory Consolidation Network</rdfs:label>
    <skos:prefLabel xml:lang="en">Memory Consolidation Network</skos:prefLabel>
    <skos:definition xml:lang="en">Consolidates experience into durable learning and contextualizes the present with the past. Active during reconsolidation and model updating.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000140">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000134"/>
    <rdfs:label xml:lang="en">Autonomous Practice</rdfs:label>
    <skos:prefLabel xml:lang="en">Autonomous Practice</skos:prefLabel>
    <skos:notation>L6</skos:notation>
    <skos:definition xml:lang="en">The person continues on their own and recognizes early warning signs.</skos:definition>
    <skos:altLabel xml:lang="en">L6: Autonomous Practice</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/L3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete L3</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000137"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000108">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Occipital Cortex</rdfs:label>
    <skos:prefLabel xml:lang="en">Occipital Cortex</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the occipital cortex, named by the neural layer of the HES.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016540"/>
    <skos:historyNote xml:lang="en">Labelled 'Visual Processing' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Occipital Cortex</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000139">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000134"/>
    <rdfs:label xml:lang="en">Integration</rdfs:label>
    <skos:prefLabel xml:lang="en">Integration</skos:prefLabel>
    <skos:notation>L5</skos:notation>
    <skos:definition xml:lang="en">New experience consolidates into an updated self-model.</skos:definition>
    <skos:altLabel xml:lang="en">L5: Integration</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/IntelligenceLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
