  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000101">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Somatosensory Cortex</rdfs:label>
    <skos:prefLabel xml:lang="en">Somatosensory Cortex</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the somatosensory cortex, named by the neural layer of the HES.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008930"/>
    <skos:historyNote xml:lang="en">Labelled 'Touch &amp; Body Mapping' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Somatosensory Cortex</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000146">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Mechanism Type</rdfs:label>
    <skos:prefLabel xml:lang="en">Mechanism Type</skos:prefLabel>
    <skos:definition xml:lang="en">A type of therapeutic intervention mechanism with defined neurobiological action.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000009"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/nausea">
