  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000068">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in Inner Conflict</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in Inner Conflict</skos:prefLabel>
    <skos:notation>T7</skos:notation>
    <skos:definition xml:lang="en">Contradictory predictions with high precision in opposing directions.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'T7: Conflict' before version 1.1.1, when the label changed to match the Human Experience Framework v3.0.1. Identified as cso:conflict until release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000081"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>SEEKING vs FEAR, or RAGE vs FEAR</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000124">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Bronfenbrenner Layer</rdfs:label>
    <skos:prefLabel xml:lang="en">Bronfenbrenner Layer</skos:prefLabel>
    <skos:definition xml:lang="en">An ecological systems layer from Bronfenbrenner's developmental ecology. Used to classify external state entities by their proximity and influence type.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000007"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000040">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Sensation Quality</rdfs:label>
    <skos:prefLabel xml:lang="en">Sensation Quality</skos:prefLabel>
    <skos:definition xml:lang="en">A phenomenological sensation descriptor. Somatic qualities, not emotional labels. Defined phenomenologically (what it feels like) rather than mechanistically (what causes it).</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/reconsolidation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete reconsolidation</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000131"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000095">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Posterior Cingulate Cortex / Precuneus</rdfs:label>
    <skos:prefLabel xml:lang="en">Posterior Cingulate Cortex / Precuneus</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the posterior cingulate cortex and precuneus, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006093"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022353"/>
    <skos:historyNote xml:lang="en">Labelled 'Self-Reflection' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Posterior Cingulate / Precuneus</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Somatic Snapshot</rdfs:label>
    <skos:prefLabel xml:lang="en">Somatic Snapshot</skos:prefLabel>
    <skos:definition xml:lang="en">A complete body state at a single moment. It holds zero or more data points; with none, nothing stands out may record that the person attended to their sensations and found nothing standing out.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000163">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">intensity</rdfs:label>
    <skos:prefLabel xml:lang="en">intensity</skos:prefLabel>
    <skos:definition xml:lang="en">An optional whole-number rating of how intense a sensation is, from 0 (not noticeable) to 10 (the most intense the person can imagine). Used on a data point, and optionally on a snapshot for the body state as a whole.</skos:definition>
    <rdfs:range rdf:nodeID="ne7c7efbaeaf1406b9751bfd8c0beb5bab1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000179">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000172"/>
    <rdfs:label xml:lang="en">Done in an intervention</rdfs:label>
    <skos:prefLabel xml:lang="en">Done in an intervention</skos:prefLabel>
    <skos:definition xml:lang="en">Obtained as something done in an intervention.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000015">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Mouth / Lips</rdfs:label>
    <skos:prefLabel xml:lang="en">Mouth / Lips</skos:prefLabel>
    <skos:notation>Zone 5</skos:notation>
    <skos:definition xml:lang="en">Tightness, numbness, trembling; speech suppression, grief expression.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000165"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001833"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne7c7efbaeaf1406b9751bfd8c0beb5bab3">
    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:maxInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000170">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">memory system</rdfs:label>
    <skos:prefLabel xml:lang="en">memory system</skos:prefLabel>
    <skos:definition xml:lang="en">The memory system a change mechanism engages.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000130"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000210">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000183"/>
    <rdfs:label xml:lang="en">Motivation</rdfs:label>
    <skos:prefLabel xml:lang="en">Motivation</skos:prefLabel>
    <skos:definition xml:lang="en">A reason for ending that is specific to the territory, for example "there's no point" in Living in Shutdown or "I'm the problem" in Living in Shame.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/affectConfiguration">
