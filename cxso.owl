    <skos:prefLabel xml:lang="en">Macrosystem</skos:prefLabel>
    <skos:definition xml:lang="en">Broad cultural and societal patterns: economic conditions, political climate, cultural norms.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/newHabitFormation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
