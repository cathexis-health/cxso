    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000160">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has change mechanism</rdfs:label>
    <skos:prefLabel xml:lang="en">has change mechanism</skos:prefLabel>
    <skos:definition xml:lang="en">The primary therapeutic change mechanism for a territory.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000130"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000182">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">HES Layer</rdfs:label>
    <skos:prefLabel xml:lang="en">HES Layer</skos:prefLabel>
    <skos:definition xml:lang="en">One of the ten layers of the Human Experience System (somatic, predictive, affective, neural, memory, relational, ecological, generational, technological, temporal).</skos:definition>
    <rdfs:comment xml:lang="en">HES layers are placed in the clinical extension because they require the HES theoretical model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/hypothalamus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
