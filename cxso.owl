  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000079">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000078"/>
    <rdfs:label xml:lang="en">Porosity pattern</rdfs:label>
    <skos:prefLabel xml:lang="en">Porosity pattern</skos:prefLabel>
    <skos:definition xml:lang="en">A blanket organization in which sensory translations are overactive: the boundary is too thin.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'Porosity Disorders (Blanket Too Thin)' before release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000171>Sensory translations overactive; build appropriate boundary thickness.</cxso:CXSO_0000171>
  </rdf:Description>
