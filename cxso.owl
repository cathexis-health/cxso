  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000069">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in the Body Under Strain</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in the Body Under Strain</skos:prefLabel>
    <skos:notation>T8</skos:notation>
    <skos:definition xml:lang="en">Brain's pain predictions maintained despite changed peripheral input; pain as construct.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000083"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>Variable by presentation</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/ActiveState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
