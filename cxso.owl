  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000099">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Anterior Insula</rdfs:label>
    <skos:prefLabel xml:lang="en">Anterior Insula</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the anterior insula, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034891"/>
    <skos:historyNote xml:lang="en">Labelled 'Body Awareness' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Anterior Insula</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/Boundary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
