    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000070"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000067">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living Under Siege</rdfs:label>
    <skos:prefLabel xml:lang="en">Living Under Siege</skos:prefLabel>
    <skos:notation>T6</skos:notation>
    <skos:definition xml:lang="en">Locked threat predictions with extreme precision; inability to update despite safety.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000082"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>FEAR locked, all potentially dysregulated</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/zone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
