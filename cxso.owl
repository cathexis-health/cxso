    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/heat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete heat</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000042"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000112">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Brain Network</rdfs:label>
    <skos:prefLabel xml:lang="en">Brain Network</skos:prefLabel>
    <skos:definition xml:lang="en">A functional system of interacting brain regions, as described in the research the HES draws on. Networks are concepts of the theory, not anatomical structures, so the CSO defines them itself.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000080">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000078"/>
    <rdfs:label xml:lang="en">Rigidity pattern</rdfs:label>
    <skos:prefLabel xml:lang="en">Rigidity pattern</skos:prefLabel>
    <skos:definition xml:lang="en">A blanket organization in which sensory signals are suppressed: the boundary is too thick.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'Rigidity Disorders (Blanket Too Thick)' before release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000171>Sensory signals suppressed; carefully increase permeability.</cxso:CXSO_0000171>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/seeking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete seeking</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000118"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000006">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000005"/>
    <rdfs:label xml:lang="en">Internal State</rdfs:label>
    <skos:prefLabel xml:lang="en">Internal State</skos:prefLabel>
    <skos:definition xml:lang="en">The person's physiological and psychological condition as experienced through interoception. What the person builds observer capacity for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/anteriorInsula">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete anteriorInsula</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000099"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/upperChest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete upperChest</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000020"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000211">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000183"/>
    <rdfs:label xml:lang="en">FEAR attenuation</rdfs:label>
    <skos:prefLabel xml:lang="en">FEAR attenuation</skos:prefLabel>
    <skos:definition xml:lang="en">The biological barrier lowering, so the person is less prevented rather than more motivated; for example metabolic conservation in Living in Shutdown, alcohol in Living in Addiction and Compulsion, dissociation in Living Under Siege.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000122">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">PLAY Network</rdfs:label>
    <skos:prefLabel xml:lang="en">PLAY Network</skos:prefLabel>
    <skos:definition xml:lang="en">Panksepp's PLAY system. Social joy, spontaneity, and boundary-testing. Suppression is a cross-territory marker of chronic strain; its return marks recovery.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000145">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000141"/>
    <rdfs:label xml:lang="en">Predictive</rdfs:label>
    <skos:prefLabel xml:lang="en">Predictive</skos:prefLabel>
    <skos:notation>I4</skos:notation>
    <skos:definition xml:lang="en">Pattern detection over the full blanket, over time.</skos:definition>
    <skos:altLabel xml:lang="en">I4: Predictive</skos:altLabel>
    <skos:historyNote xml:lang="en">Labelled 'L4: Predictive' before release 2.0.0; renumbered I4 so it is not confused with the learning levels.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000097">
