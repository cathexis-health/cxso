   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/wholeBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete wholeBody</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000038"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000032">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Lower Legs / Calves</rdfs:label>
    <skos:prefLabel xml:lang="en">Lower Legs / Calves</skos:prefLabel>
    <skos:notation>Zone 22</skos:notation>
    <skos:definition xml:lang="en">Heaviness, restlessness, cramping; grounding connection.</skos:definition>
    <skos:altLabel xml:lang="en">Lower Legs</skos:altLabel>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_8480048"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000215">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000184"/>
    <rdfs:label xml:lang="en">Dormant</rdfs:label>
    <skos:prefLabel xml:lang="en">Dormant</skos:prefLabel>
    <skos:notation>dormant</skos:notation>
    <skos:definition xml:lang="en">Installed predictions not currently active, which a later trigger may activate.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000021">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Solar Plexus</rdfs:label>
    <skos:prefLabel xml:lang="en">Solar Plexus</skos:prefLabel>
    <skos:notation>Zone 11</skos:notation>
    <skos:definition xml:lang="en">Churning, butterflies, knot; core anxiety, diaphragmatic tension.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035276"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/SensationQuality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete SensationQuality</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000047">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Pain</rdfs:label>
    <skos:prefLabel xml:lang="en">Pain</skos:prefLabel>
    <skos:definition xml:lang="en">Sharp, specific, localized nociception. Chronic pain territories, acute somatic distress, body-as-alarm.</skos:definition>
    <skos:altLabel xml:lang="en">hurting</skos:altLabel>
    <skos:altLabel xml:lang="en">sharp</skos:altLabel>
    <skos:altLabel xml:lang="en">stabbing</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000096">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Hippocampus</rdfs:label>
    <skos:prefLabel xml:lang="en">Hippocampus</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the hippocampus, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002421"/>
    <skos:historyNote xml:lang="en">Labelled 'Memory &amp; Context' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Hippocampus</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000111">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Cerebellum</rdfs:label>
    <skos:prefLabel xml:lang="en">Cerebellum</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the cerebellum, named by the neural layer of the HES.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002037"/>
    <skos:historyNote xml:lang="en">Labelled 'Coordination &amp; Timing' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Cerebellum</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/SEEKING">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete SEEKING</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000085"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000143">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000141"/>
    <rdfs:label xml:lang="en">Adaptive</rdfs:label>
    <skos:prefLabel xml:lang="en">Adaptive</skos:prefLabel>
    <skos:notation>I2</skos:notation>
    <skos:definition xml:lang="en">Pattern detection over internal and external states.</skos:definition>
    <skos:altLabel xml:lang="en">I2: Adaptive</skos:altLabel>
    <skos:historyNote xml:lang="en">Labelled 'L2: Adaptive' before release 2.0.0; renumbered I2 so it is not confused with the learning levels.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000200">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000182"/>
    <rdfs:label xml:lang="en">The Somatic Layer</rdfs:label>
    <skos:prefLabel xml:lang="en">The Somatic Layer</skos:prefLabel>
    <skos:notation>somatic</skos:notation>
    <skos:definition xml:lang="en">The somatic layer of the Human Experience System.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/mask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete mask</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000074"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000212">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000183"/>
    <rdfs:label xml:lang="en">Disinhibition and access to means</rdfs:label>
    <skos:prefLabel xml:lang="en">Disinhibition and access to means</skos:prefLabel>
    <skos:definition xml:lang="en">For example intoxication in Living in Addiction and Compulsion, impulsivity in Living in Overwhelm, or means available in the environment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000141">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Intelligence Layer</rdfs:label>
    <skos:prefLabel xml:lang="en">Intelligence Layer</skos:prefLabel>
    <skos:definition xml:lang="en">A level of pattern detection over somatic data, from reflecting back what the person reported to predicting what comes next.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000031">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Knees</rdfs:label>
    <skos:prefLabel xml:lang="en">Knees</skos:prefLabel>
    <skos:notation>Zone 21</skos:notation>
    <skos:definition xml:lang="en">Weakness, instability; structural anxiety. Clinically informative.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001465"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000023">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Lower Abdomen / Pelvis</rdfs:label>
    <skos:prefLabel xml:lang="en">Lower Abdomen / Pelvis</skos:prefLabel>
    <skos:notation>Zone 13</skos:notation>
    <skos:definition xml:lang="en">Tension, numbness, dissociation; trauma-sensitive zone.</skos:definition>
    <skos:altLabel xml:lang="en">Lower Abdomen</skos:altLabel>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002355"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013203"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000103">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Brainstem</rdfs:label>
    <skos:prefLabel xml:lang="en">Brainstem</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the brainstem, including the periaqueductal gray, the nucleus of the solitary tract and the raphe nuclei, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002298"/>
    <skos:historyNote xml:lang="en">Labelled 'Core Survival Systems' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Brainstem (PAG / NTS / Raphe)</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000029">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Hips</rdfs:label>
    <skos:prefLabel xml:lang="en">Hips</skos:prefLabel>
    <skos:notation>Zone 19</skos:notation>
    <skos:definition xml:lang="en">Tightness, restriction; mobility, procedural tension patterns.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001464"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000192">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000181"/>
    <rdfs:label xml:lang="en">Breathwork</rdfs:label>
    <skos:prefLabel xml:lang="en">Breathwork</skos:prefLabel>
    <skos:definition xml:lang="en">Breath-based regulation; exhale-dominant patterns support parasympathetic activity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000036">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Heart</rdfs:label>
    <skos:prefLabel xml:lang="en">Heart</skos:prefLabel>
    <skos:notation>Zone 26</skos:notation>
    <skos:definition xml:lang="en">Racing, pounding, skipping; cardiac interoception distinct from chest wall tightness.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000948"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000072">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in Shame</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in Shame</skos:prefLabel>
    <skos:notation>T11</skos:notation>
    <skos:definition xml:lang="en">Self-model prediction of unworthiness; core identity prediction of defectiveness.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000082"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>PANIC/GRIEF + self-model damage</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000045">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Tingling</rdfs:label>
    <skos:prefLabel xml:lang="en">Tingling</skos:prefLabel>
    <skos:definition xml:lang="en">Fine electrical sensation, pins and needles. Autonomic arousal, hyperventilation, peripheral nervous system activation.</skos:definition>
    <skos:altLabel xml:lang="en">pins and needles</skos:altLabel>
    <skos:altLabel xml:lang="en">prickling</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000088">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000084"/>
    <rdfs:label xml:lang="en">PANIC/GRIEF</rdfs:label>
    <skos:prefLabel xml:lang="en">PANIC/GRIEF</skos:prefLabel>
    <skos:definition xml:lang="en">Separation distress, attachment. Primary system in Living in Loss. Suppressed in Living in Disconnection.</skos:definition>
    <cxso:CXSO_0000169>Anterior cingulate, bed nucleus of the stria terminalis, periaqueductal gray</cxso:CXSO_0000169>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000064">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in Loss</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in Loss</skos:prefLabel>
    <skos:notation>T3</skos:notation>
    <skos:definition xml:lang="en">The model of the world with the person in it persists after the person is gone; prediction errors on absence.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000082"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>PANIC/GRIEF up, SEEKING variable</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/thalamus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete thalamus</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000097"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000025">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Lower Back</rdfs:label>
    <skos:prefLabel xml:lang="en">Lower Back</skos:prefLabel>
    <skos:notation>Zone 15</skos:notation>
    <skos:definition xml:lang="en">Aching, tension, weakness; structural support anxiety.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000168">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">affect configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">affect configuration</skos:prefLabel>
    <skos:definition xml:lang="en">The characteristic Panksepp affect system configuration for a territory.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/dorsolateralPFC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete dorsolateralPFC</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000104"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000057">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Expansion</rdfs:label>
    <skos:prefLabel xml:lang="en">Expansion</skos:prefLabel>
    <skos:definition xml:lang="en">Outward-radiating warmth, spaciousness. A positive somatic signal, often during successful regulation. Distinct from Heat / Warmth, which has urgency: expansion is spacious.</skos:definition>
    <skos:altLabel xml:lang="en">opening</skos:altLabel>
    <skos:altLabel xml:lang="en">spacious</skos:altLabel>
    <skos:altLabel xml:lang="en">widening</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000106">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Lateral Temporal Cortex</rdfs:label>
    <skos:prefLabel xml:lang="en">Lateral Temporal Cortex</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the lateral temporal cortex, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016538"/>
    <skos:historyNote xml:lang="en">Labelled 'Language &amp; Sound Processing' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Lateral Temporal Cortex</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000073">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in Addiction and Compulsion</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in Addiction and Compulsion</skos:prefLabel>
    <skos:notation>T12</skos:notation>
    <skos:definition xml:lang="en">SEEKING system hijacked by a substance or behavior; reward predictions distorted.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000081"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>SEEKING hijacked, underlying varies</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000093">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
