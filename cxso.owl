  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000038">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Whole Body / Systemic</rdfs:label>
    <skos:prefLabel xml:lang="en">Whole Body / Systemic</skos:prefLabel>
    <skos:notation>Zone 28</skos:notation>
    <skos:definition xml:lang="en">Non-localizable sensations: diffuse fatigue, buzzing, heaviness. Genuinely systemic sensations that forcing localization would misrepresent.</skos:definition>
