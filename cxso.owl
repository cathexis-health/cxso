  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000134">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Learning Level</rdfs:label>
    <skos:prefLabel xml:lang="en">Learning Level</skos:prefLabel>
    <skos:definition xml:lang="en">One of six capacities a person builds. They tend to develop in this order, and each earlier capacity supports the ones after it, but people move between levels and may work on several at once.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000009"/>
  </rdf:Description>
