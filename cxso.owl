  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000076">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in Existential Confrontation</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in Existential Confrontation</skos:prefLabel>
    <skos:notation>T15</skos:notation>
    <skos:definition xml:lang="en">Confrontation with predictions that cannot be resolved: mortality, meaning, freedom.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000083"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>SEEKING confronting limits</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000078">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Blanket Configuration</rdfs:label>
    <skos:prefLabel xml:lang="en">Blanket Configuration</skos:prefLabel>
    <skos:definition xml:lang="en">A characteristic pattern of Markov blanket organization shared by related territories.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/forehead">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
