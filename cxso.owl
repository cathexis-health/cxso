    <skos:prefLabel xml:lang="en">Somatic Data Point</skos:prefLabel>
    <skos:definition xml:lang="en">A single sensation report: where in the body (zone), what kind (quality), and optionally how intense (a whole number from 0 to 10). The atomic unit of somatic data.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000006"/>
  </rdf:Description>
