    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000185">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Prediction</rdfs:label>
    <skos:prefLabel xml:lang="en">Prediction</skos:prefLabel>
    <skos:definition xml:lang="en">An expectation recorded before a period of experience.</skos:definition>
    <rdfs:comment xml:lang="en">A morning and evening cycle is one example of how an implementation may use this class.</rdfs:comment>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000008"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000117">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">Threat / Fear Circuit</rdfs:label>
    <skos:prefLabel xml:lang="en">Threat / Fear Circuit</skos:prefLabel>
    <skos:definition xml:lang="en">Rapid threat detection and defensive response. Panksepp's FEAR system plus cortical monitoring.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000049">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Lightness</rdfs:label>
    <skos:prefLabel xml:lang="en">Lightness</skos:prefLabel>
    <skos:definition xml:lang="en">Buoyancy, ease. Post-regulation shift, PLAY activation, reduced sympathetic tone.</skos:definition>
    <skos:altLabel xml:lang="en">buoyant</skos:altLabel>
    <skos:altLabel xml:lang="en">light</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000065">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in Disconnection</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in Disconnection</skos:prefLabel>
    <skos:notation>T4</skos:notation>
    <skos:definition xml:lang="en">Relational predictions suppressed; intimacy modeled as dangerous.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000080"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>PANIC/GRIEF suppressed, CARE down</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000007">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000005"/>
    <rdfs:label xml:lang="en">External State</rdfs:label>
    <skos:prefLabel xml:lang="en">External State</skos:prefLabel>
    <skos:definition xml:lang="en">Environmental conditions influencing internal experience. What the person cannot directly control but must relate to.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/lowerAbdomen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
