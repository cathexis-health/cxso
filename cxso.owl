  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000020">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Upper Chest</rdfs:label>
    <skos:prefLabel xml:lang="en">Upper Chest</skos:prefLabel>
    <skos:notation>Zone 10</skos:notation>
    <skos:definition xml:lang="en">Tightness, pressure, racing; FEAR system activation, cardiac awareness.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</cxso:CXSO_0000166>
  </rdf:Description>
