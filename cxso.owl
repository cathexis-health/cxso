  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000183">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Risk Mechanism</rdfs:label>
    <skos:prefLabel xml:lang="en">Risk Mechanism</skos:prefLabel>
    <skos:definition xml:lang="en">A mechanism of suicide risk, following HEF Chapter 25. The ontology names the mechanisms and defines no thresholds or scores, which remain clinical and implementation decisions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/micro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
