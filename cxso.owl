    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000132"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000011">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Head / Scalp</rdfs:label>
    <skos:prefLabel xml:lang="en">Head / Scalp</skos:prefLabel>
    <skos:notation>Zone 1</skos:notation>
    <skos:definition xml:lang="en">Tension headaches, pressure, cognitive overwhelm.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000403"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000098">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Amygdala</rdfs:label>
    <skos:prefLabel xml:lang="en">Amygdala</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the amygdala, named by the neural layer of the HES.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001876"/>
    <skos:historyNote xml:lang="en">Labelled 'Threat &amp; Salience Detection' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Amygdala</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000169">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">neural substrate</rdfs:label>
    <skos:prefLabel xml:lang="en">neural substrate</skos:prefLabel>
    <skos:definition xml:lang="en">The brain structures in which an affect system's circuitry lies.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000084"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000035">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Vestibular / Balance</rdfs:label>
    <skos:prefLabel xml:lang="en">Vestibular / Balance</skos:prefLabel>
    <skos:notation>Zone 25</skos:notation>
    <skos:definition xml:lang="en">Dizziness, unsteadiness, groundlessness; dissociative and transition states.</skos:definition>
    <skos:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004681"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000151">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete memoryReconsolidationMechanism</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000131"/>
    <skos:historyNote xml:lang="en">At release 2.0.0 this code was retired because Memory Reconsolidation is one concept. The kept code is the ChangeMechanism individual (the paper names reconsolidation as one of the three change mechanisms). The retired code is never reused. Data recorded under it stays readable.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000186">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Prediction Check</rdfs:label>
    <skos:prefLabel xml:lang="en">Prediction Check</skos:prefLabel>
    <skos:definition xml:lang="en">A record of what happened, made after the period a prediction described.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000008"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000110">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Basal Ganglia</rdfs:label>
    <skos:prefLabel xml:lang="en">Basal Ganglia</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the basal ganglia, including the nucleus accumbens, caudate and putamen, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010011"/>
    <skos:historyNote xml:lang="en">Labelled 'Habits &amp; Motivation' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Basal Ganglia (NAc / Caudate / Putamen)</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/macro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete macro</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000128"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000039">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Unspecified</rdfs:label>
    <skos:prefLabel xml:lang="en">Unspecified</skos:prefLabel>
    <skos:notation>Zone 29</skos:notation>
    <skos:definition xml:lang="en">Present but not yet localized. Therapeutically important for people who are developing interoceptive capacity. The ratio of unspecified-to-localized reports over time measures developing body awareness.</skos:definition>
    <skos:altLabel xml:lang="en">Can't Pinpoint</skos:altLabel>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/threat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete threat</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000062"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000113">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">Default Mode Network</rdfs:label>
    <skos:prefLabel xml:lang="en">Default Mode Network</skos:prefLabel>
    <skos:definition xml:lang="en">Self-referential processing, autobiographical memory, mind-wandering, future simulation. Active during rest. Overactive in rumination (Living in Shutdown).</skos:definition>
  </rdf:Description>
