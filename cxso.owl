    <skos:definition xml:lang="en">The direction of therapeutic work for a blanket configuration.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000078"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
