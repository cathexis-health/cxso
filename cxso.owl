  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000154">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has blanket component</rdfs:label>
    <skos:prefLabel xml:lang="en">has blanket component</skos:prefLabel>
    <skos:definition xml:lang="en">The primary Markov blanket component this entity belongs to.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000005"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000022">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Stomach / Abdomen</rdfs:label>
    <skos:prefLabel xml:lang="en">Stomach / Abdomen</skos:prefLabel>
    <skos:notation>Zone 12</skos:notation>
    <skos:definition xml:lang="en">Nausea, churning, sinking; gut-brain axis, visceral distress.</skos:definition>
    <skos:altLabel xml:lang="en">Stomach</skos:altLabel>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000945"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000171">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">therapeutic direction</rdfs:label>
