    <skos:prefLabel xml:lang="en">Ventromedial Prefrontal / Orbitofrontal Cortex</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the ventromedial prefrontal and orbitofrontal cortex, named by the neural layer of the HES.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004167"/>
    <skos:historyNote xml:lang="en">Labelled 'Prediction &amp; Evaluation' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Ventromedial PFC / OFC</cxso:CXSO_0000165>
  </rdf:Description>
