    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000012"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000159">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">quality</rdfs:label>
    <skos:prefLabel xml:lang="en">quality</skos:prefLabel>
    <skos:definition xml:lang="en">The phenomenological sensation quality reported.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000002"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000197">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000181"/>
    <rdfs:label xml:lang="en">Containment</rdfs:label>
    <skos:prefLabel xml:lang="en">Containment</skos:prefLabel>
    <skos:definition xml:lang="en">Practices that build a felt sense of boundary and limit how much is held at once.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000084">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Primary Affect System</rdfs:label>
    <skos:prefLabel xml:lang="en">Primary Affect System</skos:prefLabel>
    <skos:definition xml:lang="en">One of Panksepp's seven genetically encoded primary affect systems with distinct neural circuitry.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000077">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living With a Changing Brain</rdfs:label>
    <skos:prefLabel xml:lang="en">Living With a Changing Brain</skos:prefLabel>
    <skos:notation>T16</skos:notation>
    <skos:definition xml:lang="en">Memory systems themselves degrading; predictions increasingly unreliable. Procedural memory is the most resilient system.</skos:definition>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000083"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>RAGE (frustration), FEAR, PANIC/GRIEF</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000123">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">Somatomotor Network</rdfs:label>
    <skos:prefLabel xml:lang="en">Somatomotor Network</skos:prefLabel>
    <skos:definition xml:lang="en">Motor execution, body schema, proprioception. The action network, engaged by movement-based regulation practices.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000201">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000182"/>
    <rdfs:label xml:lang="en">The Predictive Layer</rdfs:label>
    <skos:prefLabel xml:lang="en">The Predictive Layer</skos:prefLabel>
    <skos:notation>predictive</skos:notation>
    <skos:definition xml:lang="en">The predictive layer of the Human Experience System.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/somatosensoryCortex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
