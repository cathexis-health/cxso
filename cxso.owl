  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000167">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">territory number</rdfs:label>
    <skos:prefLabel xml:lang="en">territory number</skos:prefLabel>
    <skos:definition xml:lang="en">The number of a territory, from 1 to 16, as used in clinical practice ("T1").</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000052">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Buzzing</rdfs:label>
    <skos:prefLabel xml:lang="en">Buzzing</skos:prefLabel>
    <skos:definition xml:lang="en">An electrical hum or fizz. Anxiety activation, restlessness, autonomic hyperarousal.</skos:definition>
    <skos:altLabel xml:lang="en">electric</skos:altLabel>
    <skos:altLabel xml:lang="en">fizzing</skos:altLabel>
    <skos:altLabel xml:lang="en">humming</skos:altLabel>
    <skos:altLabel xml:lang="en">wired</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000132">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000130"/>
    <rdfs:label xml:lang="en">New Habit Formation</rdfs:label>
    <skos:prefLabel xml:lang="en">New Habit Formation</skos:prefLabel>
    <skos:definition xml:lang="en">Builds new procedural patterns through repetition and reward.</skos:definition>
    <cxso:CXSO_0000170>Procedural memory (basal ganglia-dependent)</cxso:CXSO_0000170>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/shutdown">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
