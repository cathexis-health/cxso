    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000148"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000060">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Trembling</rdfs:label>
    <skos:prefLabel xml:lang="en">Trembling</skos:prefLabel>
    <skos:definition xml:lang="en">Fine involuntary shaking, felt or seen as movement. Somatic discharge: can be regulatory (release after activation) or a sign of distress (Living Under Siege freeze-thaw, Living in Overwhelm spillover).</skos:definition>
    <skos:altLabel xml:lang="en">quivering</skos:altLabel>
    <skos:altLabel xml:lang="en">shaking</skos:altLabel>
    <skos:altLabel xml:lang="en">shivering</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/disconnection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete disconnection</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000065"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/conflict">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete conflict</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000068"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000075">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in a World Built for Someone Else</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in a World Built for Someone Else</skos:prefLabel>
    <skos:notation>T14</skos:notation>
    <skos:definition xml:lang="en">Sensory processing differences; predictions calibrated to atypical neurology.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'T14: Altered Body/Mind' before version 1.1.1, when the label changed to match the Human Experience Framework v3.0.1. Identified as cso:alteredBodyMind until release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000083"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>Variable</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000144">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000141"/>
    <rdfs:label xml:lang="en">Pattern</rdfs:label>
    <skos:prefLabel xml:lang="en">Pattern</skos:prefLabel>
    <skos:notation>I3</skos:notation>
    <skos:definition xml:lang="en">Pattern detection over internal, external and sensory states.</skos:definition>
    <skos:altLabel xml:lang="en">I3: Pattern</skos:altLabel>
    <skos:historyNote xml:lang="en">Labelled 'L3: Pattern' before release 2.0.0; renumbered I3 so it is not confused with the learning levels.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000094">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Anterior Cingulate Cortex</rdfs:label>
    <skos:prefLabel xml:lang="en">Anterior Cingulate Cortex</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the anterior cingulate cortex, named by the neural layer of the HES.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009835"/>
    <skos:historyNote xml:lang="en">Labelled 'Conflict &amp; Error Monitoring' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Anterior Cingulate Cortex</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/floating">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete floating</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000059"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/stomach">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete stomach</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000022"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000051">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Hollowness</rdfs:label>
    <skos:prefLabel xml:lang="en">Hollowness</skos:prefLabel>
    <skos:definition xml:lang="en">Emptiness, void, absence of substance. Grief (Living in Loss), existential states (Living in Existential Confrontation), identity emptiness (Living Behind a Mask).</skos:definition>
    <skos:altLabel xml:lang="en">Hollow</skos:altLabel>
    <skos:altLabel xml:lang="en">empty</skos:altLabel>
    <skos:altLabel xml:lang="en">void</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000213">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000183"/>
    <rdfs:label xml:lang="en">Isolation</rdfs:label>
    <skos:prefLabel xml:lang="en">Isolation</skos:prefLabel>
    <skos:definition xml:lang="en">The absence of a co-regulating other; for example withdrawal in Living in Disconnection, or the intact mask in Living Behind a Mask that makes a person appear fine.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/cold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete cold</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000043"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000027">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Forearms</rdfs:label>
    <skos:prefLabel xml:lang="en">Forearms</skos:prefLabel>
    <skos:notation>Zone 17</skos:notation>
    <skos:definition xml:lang="en">Tension, tingling, weakness; action readiness or suppression.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/shoulders">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete shoulders</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000019"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000028">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Hands</rdfs:label>
    <skos:prefLabel xml:lang="en">Hands</skos:prefLabel>
    <skos:notation>Zone 18</skos:notation>
    <skos:definition xml:lang="en">Clenching, tingling, numbness, sweating; highly expressive zone.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002398"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000056">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Stillness</rdfs:label>
    <skos:prefLabel xml:lang="en">Stillness</skos:prefLabel>
    <skos:definition xml:lang="en">Calm absence of movement. Living in Shutdown: stillness as arrival, not absence. Living in Existential Confrontation: presence without action. A rare positive signal.</skos:definition>
    <skos:altLabel xml:lang="en">quiet</skos:altLabel>
    <skos:altLabel xml:lang="en">settled</skos:altLabel>
    <skos:altLabel xml:lang="en">still</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/expansion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete expansion</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000057"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/L5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete L5</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000139"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/addiction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete addiction</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000073"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000149">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000146"/>
    <rdfs:label xml:lang="en">Titrated Somatic Contact</rdfs:label>
    <skos:prefLabel xml:lang="en">Titrated Somatic Contact</skos:prefLabel>
    <skos:definition xml:lang="en">Titrated contact with somatic activation patterns; controlled nervous system processing.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'Somatic Experiencing' before release 2.0.0. Somatic Experiencing is a registered trademark for Peter Levine's method, so the label is now generic. The code and definition are unchanged.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000115">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">Central Executive Network</rdfs:label>
    <skos:prefLabel xml:lang="en">Central Executive Network</skos:prefLabel>
    <skos:definition xml:lang="en">Cognitive control, working memory, goal-directed behavior, strategic planning.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000162">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has region</rdfs:label>
    <skos:prefLabel xml:lang="en">has region</skos:prefLabel>
    <skos:definition xml:lang="en">A brain network that includes a specific brain region.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000046">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Numbness</rdfs:label>
    <skos:prefLabel xml:lang="en">Numbness</skos:prefLabel>
    <skos:definition xml:lang="en">Absence of sensation, deadness, blankness. Dissociation, shutdown, protective disconnection from interoceptive signal.</skos:definition>
    <skos:altLabel xml:lang="en">blank</skos:altLabel>
    <skos:altLabel xml:lang="en">can't feel it</skos:altLabel>
    <skos:altLabel xml:lang="en">dead</skos:altLabel>
    <skos:altLabel xml:lang="en">numb</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Justin DeGarbo</dcterms:creator>
    <dcterms:description xml:lang="en">The Cathexis Somatic Ontology (CSO) is an open, machine-readable vocabulary for first-person somatic experience. Release 2.0.0 splits the vocabulary into a core anyone can use without the theory (zones, sensation qualities, intensity, time, evidence kind, and the snapshot and data-point structure) and a clinical extension that imports the core (territories, blanket configurations, affect systems, change and risk mechanisms, practice types, learning levels, territory status, and HES layers). Every term has a permanent opaque code (CXSO_0000001 onward) in the https://w3id.org/cxso/ namespace. Identifiers from CSO v1.1 are kept as deprecated aliases.</dcterms:description>
    <dcterms:identifier>10.5281/zenodo.18859896</dcterms:identifier>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-29</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-26</dcterms:modified>
    <dcterms:publisher>Cathexis Health LLC</dcterms:publisher>
    <dcterms:title xml:lang="en">Cathexis Somatic Ontology (CSO)</dcterms:title>
    <vann:preferredNamespacePrefix>cxso</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/cxso/</vann:preferredNamespaceUri>
    <owl:priorVersion rdf:resource="https://cathexis.health/ontology/cso/v1.1.1/"/>
    <owl:versionIRI rdf:resource="https://w3id.org/cxso/releases/2.0.0/cxso.ttl"/>
    <owl:versionInfo>2.0.0</owl:versionInfo>
    <skos:changeNote xml:lang="en">Release 2.0.0 (November 2026): permanent opaque identifiers (CXSO_0000001 onward) under https://w3id.org/cxso/ replace name-based identifiers, and every v1.1 identifier is kept as a deprecated alias that points to its new code. The ontology is split into a core module and a clinical extension in the same namespace. Intensity becomes an optional whole-number rating from 0 to 10 (a breaking change from the 0.0 to 1.0 scale). New terms include evidence kind, nothing stands out, timestamp, practice types, HES layers, risk mechanisms and territory status. Every term has a definition. Zones are linked to UBERON. Brain regions are labelled by anatomy, not by function. Somatic Experiencing is relabelled Titrated Somatic Contact. SNOMED CT codes are not part of the open release. Paper version 2.3 and ontology release 2.0.0 are numbered separately.</skos:changeNote>
  </rdf:Description>
