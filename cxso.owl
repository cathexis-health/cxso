  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000147">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000146"/>
    <rdfs:label xml:lang="en">Autonomic Regulation</rdfs:label>
    <skos:prefLabel xml:lang="en">Autonomic Regulation</skos:prefLabel>
    <skos:definition xml:lang="en">Shifts autonomic state via parasympathetic or sympathetic modulation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000104">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000092"/>
    <rdfs:label xml:lang="en">Dorsolateral Prefrontal Cortex</rdfs:label>
    <skos:prefLabel xml:lang="en">Dorsolateral Prefrontal Cortex</skos:prefLabel>
    <skos:definition xml:lang="en">A brain region: the dorsolateral prefrontal cortex, named by the neural layer of the HES.</skos:definition>
    <skos:exactMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009834"/>
    <skos:historyNote xml:lang="en">Labelled 'Context Processing' before release 2.0.0. That label named a psychological function, and the CSO does not assign a psychological function to a single region (paper, Section 4.6).</skos:historyNote>
    <cxso:CXSO_0000164 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cxso:CXSO_0000164>
    <cxso:CXSO_0000165>Dorsolateral Prefrontal Cortex</cxso:CXSO_0000165>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/IL3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
