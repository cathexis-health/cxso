  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000071">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living in an Unfamiliar Life</rdfs:label>
    <skos:prefLabel xml:lang="en">Living in an Unfamiliar Life</skos:prefLabel>
    <skos:notation>T10</skos:notation>
    <skos:definition xml:lang="en">Generative model of self under active reconstruction; predictions temporarily unreliable.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'T10: Transition' before version 1.1.1, when the label changed to match the Human Experience Framework v3.0.1. Identified as cso:transition until release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000081"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>SEEKING disrupted, PANIC/GRIEF active</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000114">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000112"/>
    <rdfs:label xml:lang="en">Salience Network</rdfs:label>
    <skos:prefLabel xml:lang="en">Salience Network</skos:prefLabel>
    <skos:definition xml:lang="en">Detects what matters: threat, novelty, reward, social significance. The switchboard that routes attention between internal and external processing.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000008">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000005"/>
    <rdfs:label xml:lang="en">Sensory State</rdfs:label>
    <skos:prefLabel xml:lang="en">Sensory State</skos:prefLabel>
    <skos:definition xml:lang="en">The boundary where external becomes internal: the translation mechanism. Where prediction lives. The most clinically important component.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000048">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Heaviness</rdfs:label>
    <skos:prefLabel xml:lang="en">Heaviness</skos:prefLabel>
    <skos:definition xml:lang="en">Weight, density, gravitational pull. SEEKING suppression (Living in Shutdown), fatigue, depressive somatization.</skos:definition>
    <skos:altLabel xml:lang="en">heavy</skos:altLabel>
    <skos:altLabel xml:lang="en">leaden</skos:altLabel>
    <skos:altLabel xml:lang="en">weighed down</skos:altLabel>
  </rdf:Description>
