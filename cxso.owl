  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000087">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000084"/>
    <rdfs:label xml:lang="en">RAGE</rdfs:label>
    <skos:prefLabel xml:lang="en">RAGE</skos:prefLabel>
    <skos:definition xml:lang="en">Frustration, assertive response. Suppressed RAGE appears as jaw tension.</skos:definition>
    <cxso:CXSO_0000169>Medial amygdala, hypothalamus, periaqueductal gray</cxso:CXSO_0000169>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000153">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000146"/>
    <rdfs:label xml:lang="en">Relational Somatic</rdfs:label>
    <skos:prefLabel xml:lang="en">Relational Somatic</skos:prefLabel>
    <skos:definition xml:lang="en">Body awareness in interpersonal context.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000053">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Nausea</rdfs:label>
    <skos:prefLabel xml:lang="en">Nausea</skos:prefLabel>
    <skos:definition xml:lang="en">Stomach turning, queasiness. Gut-brain axis distress, disgust, overwhelming affect, medication effects.</skos:definition>
    <skos:altLabel xml:lang="en">churning</skos:altLabel>
    <skos:altLabel xml:lang="en">queasy</skos:altLabel>
    <skos:altLabel xml:lang="en">sick to the stomach</skos:altLabel>
  </rdf:Description>
