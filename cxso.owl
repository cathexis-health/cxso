    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000037">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Diaphragm</rdfs:label>
    <skos:prefLabel xml:lang="en">Diaphragm</skos:prefLabel>
    <skos:notation>Zone 27</skos:notation>
    <skos:definition xml:lang="en">Constriction, catching, restriction; breath holding, autonomic regulation anchor.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001103"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000090">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000084"/>
    <rdfs:label xml:lang="en">PLAY</rdfs:label>
    <skos:prefLabel xml:lang="en">PLAY</skos:prefLabel>
    <skos:definition xml:lang="en">Social learning, joy, boundary-testing. Suppression is a sensitive clinical marker across all territories.</skos:definition>
    <cxso:CXSO_0000169>Dorsomedial thalamus, posterior thalamus, parafascicular area</cxso:CXSO_0000169>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000161">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">serves territory</rdfs:label>
    <skos:prefLabel xml:lang="en">serves territory</skos:prefLabel>
    <skos:definition xml:lang="en">A mechanism type that serves a specific territory.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000146"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000199">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000181"/>
    <rdfs:label xml:lang="en">Activation</rdfs:label>
    <skos:prefLabel xml:lang="en">Activation</skos:prefLabel>
    <skos:definition xml:lang="en">Small movements and contact that raise arousal a little, for states of shutdown, heaviness or flatness (for example Living in Shutdown and Living in Shame), where regulation needs to move upward rather than toward calm.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000013">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Eyes</rdfs:label>
    <skos:prefLabel xml:lang="en">Eyes</skos:prefLabel>
    <skos:notation>Zone 3</skos:notation>
    <skos:definition xml:lang="en">Strain, pressure, burning, tears; hypervigilance, crying suppression.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000970"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/blanketComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete blanketComponent</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000154"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000217">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has snapshot</rdfs:label>
    <skos:prefLabel xml:lang="en">has snapshot</skos:prefLabel>
    <skos:definition xml:lang="en">A snapshot that is part of a trajectory. A trajectory's snapshots are ordered by their timestamps.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000004"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000131">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000130"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000146"/>
    <rdfs:label xml:lang="en">Memory Reconsolidation</rdfs:label>
    <skos:prefLabel xml:lang="en">Memory Reconsolidation</skos:prefLabel>
    <skos:definition xml:lang="en">Opens and updates emotional memory during the reconsolidation window (approximately 4 to 6 hours).</skos:definition>
    <cxso:CXSO_0000170>Emotional / implicit memory (amygdala-dependent)</cxso:CXSO_0000170>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000070">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000061"/>
    <rdfs:label xml:lang="en">Living Under Pressure From Outside</rdfs:label>
    <skos:prefLabel xml:lang="en">Living Under Pressure From Outside</skos:prefLabel>
    <skos:notation>T9</skos:notation>
    <skos:definition xml:lang="en">Accurate predictions of genuine systemic threat; the stress response is appropriate.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'T9: System Under Pressure' before version 1.1.1, when the label changed to match the Human Experience Framework v3.0.1. Identified as cso:systemPressure until release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000155 rdf:resource="https://w3id.org/cxso/CXSO_0000079"/>
    <cxso:CXSO_0000167 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</cxso:CXSO_0000167>
    <cxso:CXSO_0000168>Contextually appropriate</cxso:CXSO_0000168>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000009">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000005"/>
    <rdfs:label xml:lang="en">Active State</rdfs:label>
    <skos:prefLabel xml:lang="en">Active State</skos:prefLabel>
    <skos:definition xml:lang="en">The person's repertoire of responses: actions to minimize prediction error. The intervention library as a toolkit of active states.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/BlanketComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete BlanketComponent</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000005"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/amygdala">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete amygdala</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000098"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000061">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Territory of Human Experience</rdfs:label>
    <skos:prefLabel xml:lang="en">Territory of Human Experience</skos:prefLabel>
    <skos:definition xml:lang="en">A distinct pattern of neurobiological organization. Not a diagnosis; describes how a person's nervous system is currently organized and what that organization feels like from the inside. In Pessoa's terms, a characteristic pattern of dynamic functional coalition formation.</skos:definition>
    <cxso:CXSO_0000154 rdf:resource="https://w3id.org/cxso/CXSO_0000006"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/ExternalState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete ExternalState</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000007"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000127">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000124"/>
    <rdfs:label xml:lang="en">Exosystem</rdfs:label>
    <skos:prefLabel xml:lang="en">Exosystem</skos:prefLabel>
    <skos:definition xml:lang="en">Indirect environments that affect the individual: partner's workplace stress, community resources, media.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/memorySystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete memorySystem</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000170"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000082">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000078"/>
    <rdfs:label xml:lang="en">Damage pattern</rdfs:label>
    <skos:prefLabel xml:lang="en">Damage pattern</skos:prefLabel>
    <skos:definition xml:lang="en">A blanket organization in which the boundary is ruptured: it is torn.</skos:definition>
    <skos:historyNote xml:lang="en">Labelled 'Damage Patterns (Blanket Torn)' before release 2.0.0.</skos:historyNote>
    <cxso:CXSO_0000171>Boundary ruptured; safety first, stabilize before reshaping.</cxso:CXSO_0000171>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000191">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has territory status</rdfs:label>
    <skos:prefLabel xml:lang="en">has territory status</skos:prefLabel>
    <skos:definition xml:lang="en">Whether a territory is active or dormant for a person.</skos:definition>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000184"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000024">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
