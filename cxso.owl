  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000085">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000084"/>
    <rdfs:label xml:lang="en">SEEKING</rdfs:label>
    <skos:prefLabel xml:lang="en">SEEKING</skos:prefLabel>
    <skos:definition xml:lang="en">Dopaminergic motivation, exploration, curiosity. Suppression is a hallmark of Living in Shutdown.</skos:definition>
    <cxso:CXSO_0000169>Ventral tegmental area, nucleus accumbens, lateral hypothalamus</cxso:CXSO_0000169>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000043">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Cold</rdfs:label>
    <skos:prefLabel xml:lang="en">Cold</skos:prefLabel>
    <skos:definition xml:lang="en">Temperature decrease, chilling. Dissociative states, withdrawal, circulatory changes in freeze responses.</skos:definition>
    <skos:altLabel xml:lang="en">chilled</skos:altLabel>
    <skos:altLabel xml:lang="en">chilly</skos:altLabel>
    <skos:altLabel xml:lang="en">icy</skos:altLabel>
  </rdf:Description>
