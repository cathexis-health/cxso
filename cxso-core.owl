    <rdfs:label xml:lang="en">Numbness</rdfs:label>
    <skos:prefLabel xml:lang="en">Numbness</skos:prefLabel>
    <skos:definition xml:lang="en">Absence of sensation, deadness, blankness. Dissociation, shutdown, protective disconnection from interoceptive signal.</skos:definition>
    <skos:altLabel xml:lang="en">blank</skos:altLabel>
    <skos:altLabel xml:lang="en">can't feel it</skos:altLabel>
    <skos:altLabel xml:lang="en">dead</skos:altLabel>
    <skos:altLabel xml:lang="en">numb</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000051">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Hollowness</rdfs:label>
    <skos:prefLabel xml:lang="en">Hollowness</skos:prefLabel>
    <skos:definition xml:lang="en">Emptiness, void, absence of substance. Grief (Living in Loss), existential states (Living in Existential Confrontation), identity emptiness (Living Behind a Mask).</skos:definition>
    <skos:altLabel xml:lang="en">Hollow</skos:altLabel>
    <skos:altLabel xml:lang="en">empty</skos:altLabel>
    <skos:altLabel xml:lang="en">void</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/lowerAbdomen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete lowerAbdomen</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000023"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000159">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">quality</rdfs:label>
    <skos:prefLabel xml:lang="en">quality</skos:prefLabel>
    <skos:definition xml:lang="en">The phenomenological sensation quality reported.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000002"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/trembling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete trembling</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000060"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000028">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Hands</rdfs:label>
    <skos:prefLabel xml:lang="en">Hands</skos:prefLabel>
    <skos:notation>Zone 18</skos:notation>
    <skos:definition xml:lang="en">Clenching, tingling, numbness, sweating; highly expressive zone.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002398"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/tightness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete tightness</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000041"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd91cdde053634035a88244c6bc343f4fb2">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd91cdde053634035a88244c6bc343f4fb5">
    <rdf:first rdf:nodeID="nd91cdde053634035a88244c6bc343f4fb3"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000040">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Sensation Quality</rdfs:label>
    <skos:prefLabel xml:lang="en">Sensation Quality</skos:prefLabel>
    <skos:definition xml:lang="en">A phenomenological sensation descriptor. Somatic qualities, not emotional labels. Defined phenomenologically (what it feels like) rather than mechanistically (what causes it).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Somatic Data Point</rdfs:label>
    <skos:prefLabel xml:lang="en">Somatic Data Point</skos:prefLabel>
    <skos:definition xml:lang="en">A single sensation report: where in the body (zone), what kind (quality), and optionally how intense (a whole number from 0 to 10). The atomic unit of somatic data.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/SomaticTrajectory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete SomaticTrajectory</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000004"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000016">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Throat</rdfs:label>
    <skos:prefLabel xml:lang="en">Throat</skos:prefLabel>
    <skos:notation>Zone 6</skos:notation>
    <skos:definition xml:lang="en">Constriction, lump; suppressed expression across multiple territories.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000341"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/throat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete throat</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000016"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/diaphragm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete diaphragm</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000037"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/unspecified">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete unspecified</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000039"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000172">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Evidence Kind</rdfs:label>
    <skos:prefLabel xml:lang="en">Evidence Kind</skos:prefLabel>
    <skos:definition xml:lang="en">How a data point was obtained: said by the person, measured by an instrument, sensed by a device, done in an intervention, or noticed by the system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000163">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">intensity</rdfs:label>
    <skos:prefLabel xml:lang="en">intensity</skos:prefLabel>
    <skos:definition xml:lang="en">An optional whole-number rating of how intense a sensation is, from 0 (not noticeable) to 10 (the most intense the person can imagine). Used on a data point, and optionally on a snapshot for the body state as a whole.</skos:definition>
    <rdfs:range rdf:nodeID="nd91cdde053634035a88244c6bc343f4fb1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000004">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Somatic Trajectory</rdfs:label>
    <skos:prefLabel xml:lang="en">Somatic Trajectory</skos:prefLabel>
    <skos:definition xml:lang="en">A body state over time: an ordered series of snapshots for one person. Aggregates computed from the series are an implementation concern, not part of the ontology.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000178">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000172"/>
    <rdfs:label xml:lang="en">Sensed by a device</rdfs:label>
    <skos:prefLabel xml:lang="en">Sensed by a device</skos:prefLabel>
    <skos:definition xml:lang="en">Obtained as something sensed by a device.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/jaw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
