    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000051"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/SomaticEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete SomaticEntity</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000011">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Head / Scalp</rdfs:label>
    <skos:prefLabel xml:lang="en">Head / Scalp</skos:prefLabel>
    <skos:notation>Zone 1</skos:notation>
    <skos:definition xml:lang="en">Tension headaches, pressure, cognitive overwhelm.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000403"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000043">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Cold</rdfs:label>
    <skos:prefLabel xml:lang="en">Cold</skos:prefLabel>
    <skos:definition xml:lang="en">Temperature decrease, chilling. Dissociative states, withdrawal, circulatory changes in freeze responses.</skos:definition>
    <skos:altLabel xml:lang="en">chilled</skos:altLabel>
    <skos:altLabel xml:lang="en">chilly</skos:altLabel>
    <skos:altLabel xml:lang="en">icy</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/numbness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete numbness</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000046"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/vestibular">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete vestibular</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000035"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000053">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Nausea</rdfs:label>
    <skos:prefLabel xml:lang="en">Nausea</skos:prefLabel>
    <skos:definition xml:lang="en">Stomach turning, queasiness. Gut-brain axis distress, disgust, overwhelming affect, medication effects.</skos:definition>
    <skos:altLabel xml:lang="en">churning</skos:altLabel>
    <skos:altLabel xml:lang="en">queasy</skos:altLabel>
    <skos:altLabel xml:lang="en">sick to the stomach</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/pelvicFloor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete pelvicFloor</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000034"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000020">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Upper Chest</rdfs:label>
    <skos:prefLabel xml:lang="en">Upper Chest</skos:prefLabel>
    <skos:notation>Zone 10</skos:notation>
    <skos:definition xml:lang="en">Tightness, pressure, racing; FEAR system activation, cardiac awareness.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000018">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Neck (Back)</rdfs:label>
    <skos:prefLabel xml:lang="en">Neck (Back)</skos:prefLabel>
    <skos:notation>Zone 8</skos:notation>
    <skos:definition xml:lang="en">Tension, stiffness, bracing; protective posture.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012477"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000179">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000172"/>
    <rdfs:label xml:lang="en">Done in an intervention</rdfs:label>
    <skos:prefLabel xml:lang="en">Done in an intervention</skos:prefLabel>
    <skos:definition xml:lang="en">Obtained as something done in an intervention.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000024">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Upper Back</rdfs:label>
    <skos:prefLabel xml:lang="en">Upper Back</skos:prefLabel>
    <skos:notation>Zone 14</skos:notation>
    <skos:definition xml:lang="en">Tension, aching, bracing; protective posture, chronic guarding.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000217">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has snapshot</rdfs:label>
    <skos:prefLabel xml:lang="en">has snapshot</skos:prefLabel>
    <skos:definition xml:lang="en">A snapshot that is part of a trajectory. A trajectory's snapshots are ordered by their timestamps.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000004"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/nausea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete nausea</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000053"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/upperLegs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete upperLegs</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000030"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/vibration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete vibration</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000055"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/quality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete quality</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000159"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000059">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Floating</rdfs:label>
    <skos:prefLabel xml:lang="en">Floating</skos:prefLabel>
    <skos:definition xml:lang="en">Untethered, drifting sensation. Living in an Unfamiliar Life: groundlessness. Living Under Siege: dissociative lightness. Distinct from Lightness, which has buoyancy: floating has no anchor.</skos:definition>
    <skos:altLabel xml:lang="en">drifting</skos:altLabel>
    <skos:altLabel xml:lang="en">spacey</skos:altLabel>
    <skos:altLabel xml:lang="en">unanchored</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000038">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Whole Body / Systemic</rdfs:label>
    <skos:prefLabel xml:lang="en">Whole Body / Systemic</skos:prefLabel>
    <skos:notation>Zone 28</skos:notation>
    <skos:definition xml:lang="en">Non-localizable sensations: diffuse fatigue, buzzing, heaviness. Genuinely systemic sensations that forcing localization would misrepresent.</skos:definition>
    <skos:altLabel xml:lang="en">Whole Body</skos:altLabel>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/mouthLips">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete mouthLips</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000015"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000034">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Pelvic Floor</rdfs:label>
    <skos:prefLabel xml:lang="en">Pelvic Floor</skos:prefLabel>
    <skos:notation>Zone 24</skos:notation>
    <skos:definition xml:lang="en">Deep guarding, tension, numbness; trauma-sensitive, sexual and attachment associations.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008612"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000049">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Lightness</rdfs:label>
    <skos:prefLabel xml:lang="en">Lightness</skos:prefLabel>
    <skos:definition xml:lang="en">Buoyancy, ease. Post-regulation shift, PLAY activation, reduced sympathetic tone.</skos:definition>
    <skos:altLabel xml:lang="en">buoyant</skos:altLabel>
    <skos:altLabel xml:lang="en">light</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000158">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">zone</rdfs:label>
    <skos:prefLabel xml:lang="en">zone</skos:prefLabel>
    <skos:definition xml:lang="en">The anatomical zone where a sensation was reported.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000002"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000037">
