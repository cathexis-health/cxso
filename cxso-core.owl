>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000032">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Lower Legs / Calves</rdfs:label>
    <skos:prefLabel xml:lang="en">Lower Legs / Calves</skos:prefLabel>
    <skos:notation>Zone 22</skos:notation>
    <skos:definition xml:lang="en">Heaviness, restlessness, cramping; grounding connection.</skos:definition>
    <skos:altLabel xml:lang="en">Lower Legs</skos:altLabel>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_8480048"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/wholeBody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete wholeBody</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000038"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000041">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Tightness</rdfs:label>
    <skos:prefLabel xml:lang="en">Tightness</skos:prefLabel>
    <skos:definition xml:lang="en">Constriction, gripping, clenching. FEAR activation, muscular bracing, suppressed expression. Most commonly reported quality across populations.</skos:definition>
    <skos:altLabel xml:lang="en">clenching</skos:altLabel>
    <skos:altLabel xml:lang="en">constriction</skos:altLabel>
    <skos:altLabel xml:lang="en">gripping</skos:altLabel>
    <skos:altLabel xml:lang="en">knot</skos:altLabel>
    <skos:altLabel xml:lang="en">stiffness</skos:altLabel>
    <skos:altLabel xml:lang="en">tense</skos:altLabel>
    <skos:altLabel xml:lang="en">tension</skos:altLabel>
    <skos:altLabel xml:lang="en">tight</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000021">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Solar Plexus</rdfs:label>
    <skos:prefLabel xml:lang="en">Solar Plexus</skos:prefLabel>
    <skos:notation>Zone 11</skos:notation>
    <skos:definition xml:lang="en">Churning, butterflies, knot; core anxiety, diaphragmatic tension.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035276"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/SensationQuality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete SensationQuality</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000047">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Pain</rdfs:label>
    <skos:prefLabel xml:lang="en">Pain</skos:prefLabel>
    <skos:definition xml:lang="en">Sharp, specific, localized nociception. Chronic pain territories, acute somatic distress, body-as-alarm.</skos:definition>
    <skos:altLabel xml:lang="en">hurting</skos:altLabel>
    <skos:altLabel xml:lang="en">sharp</skos:altLabel>
    <skos:altLabel xml:lang="en">stabbing</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/heaviness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete heaviness</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000048"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/hands">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete hands</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000028"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/tingling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete tingling</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000045"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/upperBack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete upperBack</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000024"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000050">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Pulsing</rdfs:label>
    <skos:prefLabel xml:lang="en">Pulsing</skos:prefLabel>
    <skos:definition xml:lang="en">Rhythmic beat, throbbing. Cardiovascular awareness, autonomic oscillation, activation pattern.</skos:definition>
    <skos:altLabel xml:lang="en">beating</skos:altLabel>
    <skos:altLabel xml:lang="en">pounding</skos:altLabel>
    <skos:altLabel xml:lang="en">throbbing</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/buzzing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete buzzing</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000052"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000056">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Stillness</rdfs:label>
    <skos:prefLabel xml:lang="en">Stillness</skos:prefLabel>
    <skos:definition xml:lang="en">Calm absence of movement. Living in Shutdown: stillness as arrival, not absence. Living in Existential Confrontation: presence without action. A rare positive signal.</skos:definition>
    <skos:altLabel xml:lang="en">quiet</skos:altLabel>
    <skos:altLabel xml:lang="en">settled</skos:altLabel>
    <skos:altLabel xml:lang="en">still</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000048">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Heaviness</rdfs:label>
    <skos:prefLabel xml:lang="en">Heaviness</skos:prefLabel>
    <skos:definition xml:lang="en">Weight, density, gravitational pull. SEEKING suppression (Living in Shutdown), fatigue, depressive somatization.</skos:definition>
    <skos:altLabel xml:lang="en">heavy</skos:altLabel>
    <skos:altLabel xml:lang="en">leaden</skos:altLabel>
    <skos:altLabel xml:lang="en">weighed down</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000026">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Arms (Upper)</rdfs:label>
    <skos:prefLabel xml:lang="en">Arms (Upper)</skos:prefLabel>
    <skos:notation>Zone 16</skos:notation>
    <skos:definition xml:lang="en">Heaviness, weakness, restlessness; reaching, holding and pushing gestures.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003822"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/hips">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete hips</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000029"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000017">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Neck (Front)</rdfs:label>
    <skos:prefLabel xml:lang="en">Neck (Front)</skos:prefLabel>
    <skos:notation>Zone 7</skos:notation>
    <skos:definition xml:lang="en">Tightness, vulnerability; exposure anxiety.</skos:definition>
    <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000042">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Heat / Warmth</rdfs:label>
    <skos:prefLabel xml:lang="en">Heat / Warmth</skos:prefLabel>
    <skos:definition xml:lang="en">Radiating temperature increase, flushing. RAGE activation, shame response (facial heat), inflammatory processes.</skos:definition>
    <skos:altLabel xml:lang="en">Heat</skos:altLabel>
    <skos:altLabel xml:lang="en">burning</skos:altLabel>
    <skos:altLabel xml:lang="en">facial heat</skos:altLabel>
    <skos:altLabel xml:lang="en">flushing</skos:altLabel>
    <skos:altLabel xml:lang="en">hot</skos:altLabel>
    <skos:altLabel xml:lang="en">warm</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000031">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Knees</rdfs:label>
    <skos:prefLabel xml:lang="en">Knees</skos:prefLabel>
    <skos:notation>Zone 21</skos:notation>
    <skos:definition xml:lang="en">Weakness, instability; structural anxiety. Clinically informative.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001465"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000023">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Lower Abdomen / Pelvis</rdfs:label>
    <skos:prefLabel xml:lang="en">Lower Abdomen / Pelvis</skos:prefLabel>
    <skos:notation>Zone 13</skos:notation>
    <skos:definition xml:lang="en">Tension, numbness, dissociation; trauma-sensitive zone.</skos:definition>
    <skos:altLabel xml:lang="en">Lower Abdomen</skos:altLabel>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002355"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013203"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000027">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Forearms</rdfs:label>
    <skos:prefLabel xml:lang="en">Forearms</skos:prefLabel>
    <skos:notation>Zone 17</skos:notation>
    <skos:definition xml:lang="en">Tension, tingling, weakness; action readiness or suppression.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000029">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Hips</rdfs:label>
    <skos:prefLabel xml:lang="en">Hips</skos:prefLabel>
    <skos:notation>Zone 19</skos:notation>
    <skos:definition xml:lang="en">Tightness, restriction; mobility, procedural tension patterns.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001464"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000036">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Heart</rdfs:label>
    <skos:prefLabel xml:lang="en">Heart</skos:prefLabel>
    <skos:notation>Zone 26</skos:notation>
    <skos:definition xml:lang="en">Racing, pounding, skipping; cardiac interoception distinct from chest wall tightness.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000948"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/zone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete zone</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000158"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000175">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has evidence kind</rdfs:label>
    <skos:prefLabel xml:lang="en">has evidence kind</skos:prefLabel>
    <skos:definition xml:lang="en">The kind of evidence by which a data point was obtained.</skos:definition>
    <rdfs:domain rdf:resource="https://w3id.org/cxso/CXSO_0000002"/>
    <rdfs:range rdf:resource="https://w3id.org/cxso/CXSO_0000172"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000045">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Tingling</rdfs:label>
    <skos:prefLabel xml:lang="en">Tingling</skos:prefLabel>
    <skos:definition xml:lang="en">Fine electrical sensation, pins and needles. Autonomic arousal, hyperventilation, peripheral nervous system activation.</skos:definition>
    <skos:altLabel xml:lang="en">pins and needles</skos:altLabel>
    <skos:altLabel xml:lang="en">prickling</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/BodyZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete BodyZone</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000010">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/cxso/CXSO_0000001"/>
    <rdfs:label xml:lang="en">Body Zone</rdfs:label>
    <skos:prefLabel xml:lang="en">Body Zone</skos:prefLabel>
    <skos:definition xml:lang="en">An area of the body where a person reports a sensation. A zone is the area a person reports, not a precise anatomical boundary; it is linked to UBERON where a corresponding structure exists.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000180">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000172"/>
    <rdfs:label xml:lang="en">Noticed by the system</rdfs:label>
    <skos:prefLabel xml:lang="en">Noticed by the system</skos:prefLabel>
    <skos:definition xml:lang="en">Obtained as something noticed by the system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000025">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Lower Back</rdfs:label>
    <skos:prefLabel xml:lang="en">Lower Back</skos:prefLabel>
    <skos:notation>Zone 15</skos:notation>
    <skos:definition xml:lang="en">Aching, tension, weakness; structural support anxiety.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000014">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Jaw / TMJ</rdfs:label>
    <skos:prefLabel xml:lang="en">Jaw / TMJ</skos:prefLabel>
    <skos:notation>Zone 4</skos:notation>
    <skos:definition xml:lang="en">Clenching, grinding, tightness; RAGE suppression. Clinically informative.</skos:definition>
    <skos:altLabel xml:lang="en">Jaw</skos:altLabel>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003700"/>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011595"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000057">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Expansion</rdfs:label>
    <skos:prefLabel xml:lang="en">Expansion</skos:prefLabel>
    <skos:definition xml:lang="en">Outward-radiating warmth, spaciousness. A positive somatic signal, often during successful regulation. Distinct from Heat / Warmth, which has urgency: expansion is spacious.</skos:definition>
    <skos:altLabel xml:lang="en">opening</skos:altLabel>
    <skos:altLabel xml:lang="en">spacious</skos:altLabel>
    <skos:altLabel xml:lang="en">widening</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/upperChest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete upperChest</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000020"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/core">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Justin DeGarbo</dcterms:creator>
    <dcterms:description xml:lang="en">The CSO core: an observation vocabulary for first-person somatic experience that can be used without any clinical theory. Zones, sensation qualities, intensity, time, evidence kind, and the data point, snapshot and trajectory structure.</dcterms:description>
    <dcterms:identifier>10.5281/zenodo.18859896</dcterms:identifier>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-29</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-26</dcterms:modified>
    <dcterms:publisher>Cathexis Health LLC</dcterms:publisher>
    <dcterms:title xml:lang="en">Cathexis Somatic Ontology (CSO): core</dcterms:title>
    <vann:preferredNamespacePrefix>cxso</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/cxso/</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="https://w3id.org/cxso/releases/2.0.0/cxso-core.ttl"/>
    <owl:versionInfo>2.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000019">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Shoulders</rdfs:label>
    <skos:prefLabel xml:lang="en">Shoulders</skos:prefLabel>
    <skos:notation>Zone 9</skos:notation>
    <skos:definition xml:lang="en">Carrying, tension, elevation; extremely common across territories.</skos:definition>
    <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001467"/>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/neckFront">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete neckFront</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000017"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/upperArms">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete upperArms</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000026"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000039">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000010"/>
    <rdfs:label xml:lang="en">Unspecified</rdfs:label>
    <skos:prefLabel xml:lang="en">Unspecified</skos:prefLabel>
    <skos:notation>Zone 29</skos:notation>
    <skos:definition xml:lang="en">Present but not yet localized. Therapeutically important for people who are developing interoceptive capacity. The ratio of unspecified-to-localized reports over time measures developing body awareness.</skos:definition>
    <skos:altLabel xml:lang="en">Can't Pinpoint</skos:altLabel>
    <cxso:CXSO_0000166 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</cxso:CXSO_0000166>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/cxso/CXSO_0000044">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://w3id.org/cxso/CXSO_0000040"/>
    <rdfs:label xml:lang="en">Pressure</rdfs:label>
    <skos:prefLabel xml:lang="en">Pressure</skos:prefLabel>
    <skos:definition xml:lang="en">Compression, weight, bearing down. Overwhelm, suppressed affect, tension accumulation.</skos:definition>
    <skos:altLabel xml:lang="en">bearing down</skos:altLabel>
    <skos:altLabel xml:lang="en">compression</skos:altLabel>
    <skos:altLabel xml:lang="en">fullness</skos:altLabel>
    <skos:altLabel xml:lang="en">lump</skos:altLabel>
    <skos:altLabel xml:lang="en">weight on</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/feet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:label xml:lang="en">obsolete feet</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="https://w3id.org/cxso/CXSO_0000033"/>
    <skos:historyNote xml:lang="en">Identifier from CSO v1.1. Replaced by a permanent code at release 2.0.0.</skos:historyNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cathexis.health/ontology/cso/v1.1/hollow">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
