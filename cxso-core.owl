    <skos:prefLabel xml:lang="en">Contraction</skos:prefLabel>
    <skos:definition xml:lang="en">Inward-pulling compression. Withdrawal, bracing, protective narrowing. Living in Disconnection, Living in Shame: pulling inward.</skos:definition>
    <skos:altLabel xml:lang="en">collapsing inward</skos:altLabel>
    <skos:altLabel xml:lang="en">pulling in</skos:altLabel>
    <skos:altLabel xml:lang="en">shrinking</skos:altLabel>
  </rdf:Description>
